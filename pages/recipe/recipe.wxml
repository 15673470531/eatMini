<view wx:if="{{recipe}}" class="page detail">
  <view class="dish-hero"><view class="dish-emoji">{{recipe.emoji}}</view><view class="eyebrow">A LITTLE HOME COOKING</view><view class="dish-title">{{recipe.name}}</view><view class="page-sub">{{recipe.description}}</view><view class="dish-metrics"><text>◷ {{recipe.timeMin}} 分钟</text><text>新手友好</text><text>{{recipe.equipment}}</text></view></view>
  <view class="detail-status {{ready ? 'ready' : 'missing'}}"><view class="note-title">{{ready ? (fromInventory ? '食材种类齐了，做前核对用量' : '✓ 食材齐了，可以开做') : '还需要准备这些材料'}}</view><view wx:if="{{!ready}}" class="status-text">{{missingText}}</view><text wx:if="{{!ready && inShopping}}" class="text-link" bindtap="openShopping">已加入清单 ✓ · 去看看</text></view>
  <view class="section-head"><view class="section-title">用料清单</view><view class="servings"><view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="serving {{servings === item ? 'active' : ''}}" data-value="{{item}}" bindtap="changeServings">{{item}}人</view></view></view>
  <view class="card materials"><view wx:for="{{groups}}" wx:for-item="group" wx:key="title" class="material-group"><view class="material-heading">{{group.title}}</view><view wx:for="{{group.rows}}" wx:key="id" class="material-row"><view><text>{{item.name}}</text><text class="owned {{item.owned ? 'yes' : ''}}">{{item.owned ? '已有' : group.optional ? '可不放' : '待准备'}}</text><view wx:if="{{item.note}}" class="small muted optional-note">{{item.note}}</view></view><text class="quantity">{{item.quantity}}</text></view></view></view>
  <view wx:if="{{fromInventory}}" class="small muted quantity-note">冰箱推荐按食材种类匹配，未自动换算盒、克等单位；数量未知或不足时请按实际调整。查看做法不会扣库存，用完可在冰箱里修改。</view><view class="small muted quantity-note">{{recipe.portionNote}} 用量已按 {{servings}} 人换算；步骤中的水量以 2 人份为基准，按人数调整。耗时为参考，调味可按口味减少。鸡蛋取整颗，蒸蛋加水按实际蛋液体积计算。</view>
  <view wx:if="{{mild}}" class="tip-card">已选不吃辣：可选辣椒请省略，青椒请选不辣的甜椒。</view>
  <view class="section-head" id="steps"><view class="section-title">一步一步，好好做饭</view><text class="small muted">{{completedCount}} / {{steps.length}}</text></view>
  <view wx:if="{{cooking}}" class="cooking-hint">屏幕常亮中 · 做完一步，点一下打勾</view>
  <view class="step-card {{item.done ? 'done' : ''}}" wx:for="{{steps}}" wx:key="number" data-index="{{index}}" bindtap="toggleStep"><view class="step-number">{{item.done ? '✓' : item.number}}</view><view class="step-content">{{item.text}}</view></view>
  <view class="tip-card"><view class="note-title">厨房小贴士</view><view>{{recipe.tip}}</view></view>
  <view class="end-note">{{completedCount === steps.length ? '这顿饭，辛苦你啦。' : '步骤可点击标记，慢慢来，也很好吃。'}}</view>
</view>
<view wx:if="{{recipe}}" class="bottom-bar"><view class="detail-actions"><view bindtap="toggleFavorite" class="detail-action {{favorite ? 'is-favorite' : ''}}"><text>{{favorite ? '♥' : '♡'}}</text><text>{{favorite ? '已收藏' : '收藏'}}</text></view><view class="detail-action" bindtap="openShopping"><text>☷</text><text>买菜清单</text></view></view><button class="primary" bindtap="primaryAction">{{!ready ? (inShopping ? '查看买菜清单' : '把缺的加入清单') : (cooking ? '退出常亮模式' : '开始做饭 →')}}</button></view>
<view wx:if="{{notFound}}" class="empty"><view class="empty-icon">🥣</view><view class="empty-title">没有找到这道菜</view><view class="muted">请返回上一页重新选择。</view></view>
