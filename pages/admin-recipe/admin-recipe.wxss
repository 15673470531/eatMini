.number-fields{display:flex;gap:24rpx;margin-top:24rpx}.number-fields>view{flex:1;min-width:0}.category-options{display:flex;flex-wrap:wrap;gap:14rpx}.category-options text{padding:12rpx 20rpx;background:#f1f4ed;border-radius:24rpx;font-size:24rpx;color:#839176}.category-options .chosen{background:#dce9d4;color:#315827}.spicy-row{display:flex;justify-content:space-between;align-items:center;margin:26rpx 0;font-size:25rpx}.short-text{height:130rpx;min-height:100rpx}.add-link{font-size:25rpx;color:#416537;padding:10rpx}.remove-link{font-size:23rpx;color:#9a897a;padding:10rpx}.material-editor{padding:22rpx 0;border-bottom:1rpx solid #eff2e9}.material-editor:last-child{border-bottom:0;padding-bottom:0}.amount-row{display:flex;gap:18rpx;margin:14rpx 0}.amount-row input{flex:1;min-width:0}.amount-row picker{width:160rpx}.note-input{font-size:24rpx}.step-editor{margin:20rpx 0}.step-editor textarea{margin-top:12rpx}.admin-secondary{background:#eaf0e3;color:#3e6133;padding:22rpx;border-radius:14rpx;margin:22rpx 0;font-size:26rpx}.editor-bottom{display:flex;gap:18rpx}.editor-bottom button{flex:1}.preview-material{margin-top:24rpx}.preview-step{margin:24rpx 0;line-height:1.9;white-space:pre-wrap;font-size:27rpx}.picker-mask{position:fixed;inset:0;background:rgba(20,40,26,.3);z-index:50;display:flex;align-items:flex-end}.ingredient-picker{width:100%;background:#f8f9f4;border-radius:28rpx 28rpx 0 0;padding:30rpx 30rpx calc(24rpx + env(safe-area-inset-bottom))}.ingredient-picker .admin-search{margin-top:24rpx}.ingredient-choices{height:48vh}.choice-row{display:flex;justify-content:space-between;padding:25rpx 10rpx;border-bottom:1rpx solid #e4eadb}.choice-row .admin-sub{margin:0}
