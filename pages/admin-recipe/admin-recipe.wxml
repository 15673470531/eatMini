<view class="admin-page editor-page">
 <view wx:if="{{error}}" class="admin-empty">{{error}}<button bindtap="load">重新加载</button></view><view wx:elif="{{loading}}" class="admin-empty">正在加载…</view>
 <block wx:elif="{{allowed}}">
  <block wx:if="{{preview}}">
   <view class="admin-heading">{{form.name}}</view><view class="admin-sub">{{form.description}}</view><view class="admin-sub">{{form.servings}} 人份 · {{form.timeMin}} 分钟 · {{categoryText}}</view><view class="admin-sub">{{form.portionNote}}</view>
   <view class="form-card" wx:for="{{previewGroups}}" wx:for-item="group" wx:key="id"><view class="admin-title">{{group.label}}</view><view class="preview-material" wx:for="{{group.rows}}" wx:key="id"><view class="admin-row"><text class="grow">{{item.name}}</text><text>{{item.amount}} {{item.unit}}</text></view><view wx:if="{{item.note}}" class="admin-sub">{{item.note}}</view></view><view wx:if="{{!group.rows.length}}" class="admin-sub">无需准备</view></view>
   <view class="form-card"><view class="admin-title">做法</view><view class="preview-step" wx:for="{{form.steps}}" wx:key="index">{{index + 1}}. {{item}}</view></view><view wx:if="{{form.tip}}" class="form-card">{{form.tip}}</view>
   <view class="editor-bottom"><button class="admin-secondary" disabled="{{saving}}" bindtap="backToEdit">继续修改</button><button class="admin-primary" disabled="{{saving}}" loading="{{saving}}" bindtap="save">确认保存</button></view>
  </block>
  <block wx:else>
   <view class="form-card"><view class="field-label">菜名</view><input class="field-input" maxlength="80" value="{{form.name}}" placeholder="例如：清炒秋葵" data-field="name" bindinput="field"/><view class="field-label">一句话介绍（选填）</view><input class="field-input" maxlength="300" value="{{form.description}}" placeholder="简单、省事，好吃就行" data-field="description" bindinput="field"/>
    <view class="number-fields"><view><view class="field-label">几人合吃</view><input class="field-input" type="number" value="{{form.servings}}" data-field="servings" bindinput="field"/></view><view><view class="field-label">用时 / 分钟</view><input class="field-input" type="number" value="{{form.timeMin}}" data-field="timeMin" bindinput="field"/></view></view>
    <view class="field-label">厨具</view><picker range="{{equipments}}" value="{{equipmentIndex}}" bindchange="equipment"><view class="field-input">{{form.equipment}} ›</view></picker><view class="field-label">菜品分类（可多选）</view><view class="category-options"><text wx:for="{{categories}}" wx:key="id" class="{{item.chosen ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="category">{{item.label}}</text></view><view class="spicy-row"><text>必需材料含辣味</text><switch checked="{{form.spicy}}" color="#244e3b" bindchange="spicy"/></view>
    <view class="field-label">份量说明</view><textarea class="field-textarea short-text" maxlength="300" value="{{form.portionNote}}" data-field="portionNote" bindinput="field"/></view>
   <view class="form-card" wx:for="{{materialGroups}}" wx:for-item="group" wx:key="id"><view class="admin-row"><view class="admin-title grow">{{group.label}}</view><text class="add-link" data-group="{{group.id}}" bindtap="chooseMaterial">＋ 添加</text></view><view wx:if="{{group.id === 'optional'}}" class="admin-sub">能省就省，并说明省略后有什么区别。</view>
    <view class="material-editor" wx:for="{{group.rows}}" wx:key="id"><view class="admin-row"><text class="grow">{{item.name}}</text><text class="remove-link" data-group="{{group.id}}" data-index="{{index}}" bindtap="removeMaterial">移除</text></view><view class="amount-row"><input type="digit" class="field-input" placeholder="用量" value="{{item.amount}}" data-group="{{group.id}}" data-index="{{index}}" data-field="amount" bindinput="material"/><picker range="{{units}}" value="{{item.unitIndex}}" data-group="{{group.id}}" data-index="{{index}}" data-field="unit" bindchange="material"><view class="field-input">{{item.unit}} ▾</view></picker></view><input class="field-input note-input" maxlength="500" placeholder="{{group.id === 'optional' ? '说明省略后的区别（必填）' : '说明大小、干重等（选填）'}}" value="{{item.note}}" data-group="{{group.id}}" data-index="{{index}}" data-field="note" bindinput="material"/></view>
   </view>
   <view class="form-card"><view class="admin-title">做法步骤</view><view class="step-editor" wx:for="{{form.steps}}" wx:key="index"><view class="admin-row"><text class="grow">第 {{index + 1}} 步</text><text class="remove-link" data-index="{{index}}" bindtap="removeStep">移除</text></view><textarea class="field-textarea" maxlength="1000" value="{{item}}" data-index="{{index}}" bindinput="step" placeholder="写清楚怎么做，省事也能做熟做好吃"/></view><button class="admin-secondary" bindtap="addStep">＋ 添加一步</button><view class="field-label">小贴士（选填）</view><textarea class="field-textarea" maxlength="1000" value="{{form.tip}}" data-field="tip" bindinput="field"/></view>
   <button class="admin-primary" bindtap="previewRecipe">预览菜谱</button>
  </block>
 </block>
 <view wx:if="{{pickerOpen}}" class="picker-mask" bindtap="closePicker"><view class="ingredient-picker" catchtap="stop"><view class="admin-row"><view class="admin-title grow">选择食材</view><text bindtap="closePicker">关闭</text></view><input class="admin-search" value="{{pickerQuery}}" bindinput="searchMaterial" placeholder="搜索名称或别名"/><scroll-view scroll-y class="ingredient-choices"><view wx:for="{{choices}}" wx:key="id" class="choice-row" data-id="{{item.id}}" bindtap="addMaterial">{{item.name}}<text class="admin-sub">{{item.category}}</text></view><view wx:if="{{!choices.length}}" class="admin-sub">没有找到可添加的食材</view></scroll-view><button class="admin-secondary" bindtap="newIngredient">没找到？新增食材</button></view></view>
</view>
