<view class="page simple-results"><view class="simple-title">{{favoritesOnly ? '想吃的' : '今天能做这些'}}</view><view class="shopping-shortcut" bindtap="openShopping">买菜清单{{shoppingCount ? ' · ' + shoppingCount : ''}} ›</view><view class="simple-sub">{{favoritesOnly ? '收藏喜欢的菜，下次接着做。' : (fromInventory ? '按冰箱里的食材推荐，用量请在做饭前核对。' : '可省的配料不算缺料。')}}</view><view wx:if="{{!favoritesOnly}}" class="simple-row" bindtap="backToIngredients"><text class="ellipsis">{{selectedText || '还没选食材'}}</text><text class="text-link">修改</text></view><view wx:if="{{!favoritesOnly}}" class="result-tabs"><view wx:for="{{tabs}}" wx:key="id" class="result-tab {{tab === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeTab">{{item.label}} <text>{{item.count}}</text></view></view><scroll-view wx:if="{{categoryTabs[0].count}}" scroll-x class="dish-categories" scroll-into-view="{{categoryAnchor}}" scroll-with-animation><view class="dish-category-row"><view wx:for="{{categoryTabs}}" wx:key="id" id="category-{{item.id}}" class="dish-category {{category === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeCategory"><text>{{item.label}}</text><text class="category-count">{{item.count}}</text></view></view></scroll-view><view wx:if="{{showMore && tab === 'near' && !favoritesOnly}}" class="expanded-note">已包含需要补较多材料的菜</view><view class="recipe-card" wx:for="{{visibleRecipes}}" wx:key="id" data-id="{{item.id}}" bindtap="openRecipe"><view class="recipe-info"><view class="recipe-heading"><text class="recipe-name">{{item.name}}</text><view class="favorite {{item.favorite ? 'is-favorite' : ''}}" data-id="{{item.id}}" catchtap="toggleFavorite">{{item.favorite ? '♥' : '♡'}}</view></view><view class="small muted">{{item.timeMin}} 分钟 · {{item.equipment}}</view><view class="recipe-bottom"><view class="recipe-status {{item.ready ? 'available-text' : 'missing-text'}}">{{item.ready ? (fromInventory ? '食材种类齐了，用量请核对' : '材料齐了，可以做') : item.reason}}</view><button wx:if="{{!item.ready}}" class="quick-add {{item.inShopping ? 'added' : ''}}" data-id="{{item.id}}" catchtap="addShopping" disabled="{{item.inShopping}}">{{item.inShopping ? '已加入 ✓' : '＋ 加入清单'}}</button></view></view></view><view wx:if="{{!visibleRecipes.length}}" class="empty"><view class="empty-title">{{favoritesOnly ? '还没有收藏' : '暂时没有合适的菜'}}</view><view class="muted">{{favoritesOnly ? '在菜谱旁点一下爱心，就能留在这里。' : '换个分组，或调整一下食材和筛选。'}}</view><button wx:if="{{!favoritesOnly}}" class="secondary empty-home" bindtap="resetFilters">清除筛选</button></view><view wx:if="{{!favoritesOnly && tab === 'near' && moreCount}}" class="more-link" bindtap="toggleMore">{{showMore ? '收起' : '查看还需补较多材料的 ' + moreCount + ' 道菜'}}</view><button wx:if="{{canRandom}}" class="secondary random-button" bindtap="randomRecipe">拿不定主意？帮我选一道</button></view>
