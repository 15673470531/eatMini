.admin-page{padding:28rpx 30rpx calc(60rpx + env(safe-area-inset-bottom));color:#233d32}.admin-tabs{display:flex;gap:36rpx;margin-bottom:24rpx}.admin-tab{padding:16rpx 0;color:#899584;font-size:32rpx;border-bottom:4rpx solid transparent}.admin-tab.selected{color:#244e3b;border-color:#244e3b;font-weight:600}.admin-search{background:#edf1e8;border-radius:14rpx;padding:20rpx 24rpx;height:84rpx;font-size:26rpx;margin-bottom:20rpx}.admin-primary{background:#244e3b;color:white;border-radius:16rpx;padding:23rpx;margin:22rpx 0;font-size:28rpx}.admin-primary[disabled]{background:#ced7c7;color:#86917c}.admin-card,.form-card{background:white;border:1rpx solid #e7ece1;border-radius:20rpx;padding:26rpx;margin:18rpx 0}.admin-row{display:flex;align-items:center;gap:18rpx}.grow{flex:1;min-width:0}.admin-title{font-size:29rpx;font-weight:600}.admin-sub{font-size:23rpx;color:#87917e;margin-top:9rpx;line-height:1.6}.badge{font-size:20rpx;color:#7d8b72;background:#f1f4ed;padding:4rpx 10rpx;font-weight:400;border-radius:8rpx}.arrow{color:#9dab92;font-size:32rpx}.actions{display:flex;gap:30rpx;border-top:1rpx solid #eef1e9;padding-top:20rpx;margin-top:20rpx;color:#54734a;font-size:24rpx}.actions text{padding:6rpx 0}.admin-empty{text-align:center;padding:70rpx 10rpx;color:#899580;line-height:1.8}.admin-empty button{margin-top:24rpx}.gap-tabs{display:flex;gap:12rpx;font-size:23rpx;margin:20rpx 0}.gap-tabs text{padding:12rpx 18rpx;border-radius:22rpx;background:#edf1e7;color:#809074}.gap-tabs .chosen{background:#dce8d5;color:#33592c}.filter-note{font-size:24rpx;color:#607a54;margin:20rpx 0}.admin-heading{font-size:34rpx;font-weight:600;margin:14rpx 0 26rpx}.field-label{font-size:25rpx;color:#738467;margin:20rpx 0 12rpx}.field-label:first-child{margin-top:0}.field-input{background:#f5f7f1;padding:18rpx;border-radius:12rpx;min-height:76rpx;height:auto;font-size:27rpx;box-sizing:border-box}.field-input .arrow{float:right}.field-textarea{background:#f5f7f1;width:100%;padding:18rpx;border-radius:12rpx;min-height:140rpx;height:160rpx;font-size:26rpx;line-height:1.7;box-sizing:border-box}
