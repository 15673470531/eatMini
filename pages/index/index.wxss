/* 页面共用视觉样式见 app.wxss。 */

.mode-switch{display:flex;background:#e9ede4;border-radius:16rpx;padding:6rpx;margin:4rpx 0 30rpx}.mode-switch>view{flex:1;text-align:center;font-size:27rpx;padding:16rpx;border-radius:12rpx;color:#8b9682}.mode-switch>view.active{background:white;color:#244e3b;font-weight:600}.fridge-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.fridge-heading .simple-title{font-size:36rpx}.fridge-heading .text-link{font-size:23rpx}.fridge-shell{border:9rpx solid #dce4d5;background:#f5f7f1;border-radius:28rpx;box-shadow:0 8rpx 0 #ced7c7;overflow:hidden;margin-bottom:24rpx}.fridge-brand{display:flex;justify-content:space-between;align-items:center;background:#e5ecdf;padding:18rpx 25rpx;font-size:21rpx;color:#8d9c81;letter-spacing:3rpx}.fridge-light{width:10rpx;height:10rpx;border-radius:50%;background:#89ab75}.fridge-compartment{padding:20rpx 20rpx 28rpx;border-bottom:9rpx solid #dce4d5}.fridge-compartment:last-child{border-bottom:0}.shelf-title{font-size:23rpx;color:#8c9c80;margin-bottom:18rpx}.fridge-foods{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx}.fridge-food{display:flex;flex-direction:column;align-items:center;justify-content:center;background:#fff;border-radius:15rpx;min-height:156rpx;padding:16rpx 4rpx;border-bottom:4rpx solid #e5ecdc}.food-emoji{font-size:45rpx;line-height:1.3}.food-name{font-size:25rpx;margin-top:8rpx}.food-amount{font-size:22rpx;color:#6b855b;margin-top:6rpx}.shelf-empty{grid-column:span 3;text-align:center;color:#a4ad9c;padding:25rpx 0 35rpx;font-size:23rpx}.outside-stock{padding:24rpx 0}.import-stock{font-size:23rpx;color:#748b64;padding:24rpx 0}.stock-mask{position:fixed;inset:0;background:rgba(25,40,25,.3);z-index:90;display:flex;align-items:flex-end}.stock-sheet{width:100%;padding:32rpx 32rpx calc(35rpx + env(safe-area-inset-bottom));background:#f8f9f4;border-radius:28rpx 28rpx 0 0}.stock-current{font-size:40rpx;margin-top:26rpx}.stock-adjust{display:flex;gap:20rpx;margin:28rpx 0}.stock-adjust button{flex:1}.stock-sheet>.primary{width:100%;margin-top:24rpx}.used-up{text-align:center;font-size:25rpx;color:#9b866e;padding:28rpx 0 0}
