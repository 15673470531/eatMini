<view wx:if="{{!notFound}}" class="page stock-page"><view class="simple-title">{{editing ? '这份食材还剩多少？' : '把食材放进冰箱'}}</view><view class="simple-sub">数量可不填，记成“有”就行。位置可以修改。</view>
<view wx:if="{{!editing && !fromShopping}}"><view class="search"><input placeholder="搜索要放入的食材" value="{{query}}" bindinput="onSearch"/></view><view class="stock-suggestions"><view wx:for="{{suggestions}}" wx:key="id" class="stock-tag" data-id="{{item.id}}" bindtap="addIngredient">＋ {{item.name}}</view></view><view wx:if="{{!suggestions.length}}" class="small muted">没有其他匹配食材</view></view>
<view wx:for="{{entries}}" wx:key="id" class="stock-form"><view class="simple-row"><text class="note-title">{{item.name}}</text><text wx:if="{{!editing && !fromShopping}}" data-index="{{index}}" bindtap="removeEntry">×</text></view><view class="stock-inputs"><input type="digit" placeholder="没数过" value="{{item.quantity}}" data-index="{{index}}" bindinput="changeQuantity"/><picker range="{{units}}" value="{{item.unitIndex}}" data-index="{{index}}" bindchange="changeUnit"><view>{{item.unit}} ⌄</view></picker><picker range="{{locations}}" value="{{item.locationIndex}}" data-index="{{index}}" bindchange="changeLocation"><view>{{item.location}} ⌄</view></picker></view><view class="small text-link unknown-link" data-index="{{index}}" bindtap="setUnknown">没数过，只记为有</view></view>
<view class="local-note">{{editing ? '填写修改后的总量。用完可回冰箱标记。' : '同食材、同单位、同位置会累加；不同单位分开存。数量有一笔没数过，合计也记为“没数过”。'}}</view></view>
<view wx:if="{{!notFound}}" class="bottom-bar stock-footer"><button class="primary" disabled="{{!entries.length || saving}}" bindtap="saveEntries">{{editing ? '保存修改' : '放入冰箱 · ' + entries.length + ' 样'}}</button></view><view wx:else class="empty">这份食材已不存在，请返回冰箱查看。</view>
