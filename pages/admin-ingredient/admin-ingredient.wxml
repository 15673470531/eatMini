<view class="admin-page"><view wx:if="{{error}}" class="admin-empty">{{error}}<button bindtap="load">重新加载</button></view><view wx:elif="{{loading}}" class="admin-empty">正在加载…</view><block wx:elif="{{allowed}}"><view class="admin-heading">食材信息</view><view class="form-card"><view class="field-label">食材名称</view><input class="field-input" maxlength="50" placeholder="例如：秋葵" value="{{name}}" data-field="name" bindinput="input"/><view class="field-label">分类</view><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="field-input">{{categories[categoryIndex]}} <text class="arrow">›</text></view></picker><view class="field-label">别名（选填）</view><textarea class="field-textarea" maxlength="500" placeholder="例如：番茄、洋柿子，用顿号隔开" value="{{aliases}}" data-field="aliases" bindinput="input"/></view><button class="admin-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存食材</button></block></view>
